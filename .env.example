# Copiați în .env și schimbați valorile: cp .env.example .env
# Fișierul .env NU se publică (e în .gitignore).

# PostgreSQL
POSTGRES_USER=contahub
POSTGRES_PASSWORD=schimba-parola
POSTGRES_DB=contahub

# JWT — un șir lung și aleator, de ex.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=schimba-acest-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Cheia de criptare a IBAN-urilor (bank_accounts.iban_enc); NU se schimbă după ce există date criptate
ENCRYPTION_KEY=schimba-cheia-de-criptare

# Portul pe care nginx servește aplicația
HTTP_PORT=8080

# Utilizatorul demonstrativ (doar pentru dezvoltare; lăsați gol în producție)
DEMO_EMAIL=demo@contahub.local
DEMO_PASSWORD=demo12345

# Doar pentru `npm run dev` (frontend pe 5173, API pe 8000)
CORS_ORIGINS=http://localhost:5173

# Cheia pentru criptarea IDNP (Fernet): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PERSONAL_DATA_KEY=
