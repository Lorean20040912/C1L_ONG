// ContaHub ONG — schema bazei de date (PostgreSQL)
// Copiați acest fișier integral în https://dbdiagram.io/d

Project ContaHub_ONG {
  database_type: 'PostgreSQL'
  Note: 'Sistem web de contabilitate pentru ONG-uri (înlocuitor 1C), cu asistență AI'
}

// ───────────────────────── ENUM-uri ─────────────────────────

Enum user_role {
  admin
  chief_accountant
  accountant
  project_manager
  auditor
}

Enum document_type {
  invoice
  e_invoice
  payment_order
  bank_statement
  contract
  act
  receipt
  individual_payment
  other
}

Enum document_status {
  new
  ai_processed
  to_review
  validated
  rejected
}

Enum contract_type {
  cim [note: 'contract individual de muncă']
  civil [note: 'contract civil / prestări servicii']
}

Enum payment_direction {
  incoming
  outgoing
}

Enum update_status {
  pending
  approved
  rejected
}

Enum line_kind {
  fixed_asset
  low_value_item [note: 'OMVSD']
  material
  goods
  service
}

Enum storage_provider {
  google_drive
  local_folder [note: 'montat pe server / rețea']
  sync_agent [note: 'folder pe calculatorul utilizatorului']
}

Enum bank_file_type {
  txt
  dbf
  dbo
  xml
  csv
}

Enum ai_action_status {
  pending
  applied
  rejected
  reverted
}

Enum import_status {
  pending
  running
  done
  failed
}

Enum account_kind {
  active
  passive
  active_passive
}

Enum subconto_type {
  counterparty
  contract
  person
  item
  fixed_asset
  bank_account
  grant
  budget_line
  financing_source
}

// ───────────────────── Utilizatori și organizații ─────────────────────

Table organizations {
  id uuid [pk]
  name varchar [not null]
  idno varchar(13) [unique, not null, note: 'cod fiscal']
  legal_form varchar [note: 'AO, Fundație, SRL...']
  is_ngo boolean [default: true]
  drive_root_folder_id varchar [note: 'folderul rădăcină pe Google Drive']
  base_currency char(3) [default: 'MDL']
  ngo_category char(1) [note: 'ONG17: A asociație, B fundație, C filantropică, D culte, E partide, F presă, G alte']
  cuiio varchar [note: 'cod statistic — 5-CON']
  cfoj varchar [note: 'forma organizatorico-juridică — 5-CON']
  cfp varchar [note: 'forma de proprietate — 5-CON']
  cuatm varchar [note: 'codul localității — antet IPC21']
  caem varchar [note: 'codul activității principale']
  cnas_code varchar [note: 'cod CNAS al plătitorului']
  sfs_office varchar [note: 'subdiviziunea SFS']
  director_name varchar
  chief_accountant_name varchar
  created_at timestamp [default: `now()`]
}

Table users {
  id uuid [pk]
  email varchar [unique, not null]
  full_name varchar [not null]
  password_hash varchar [not null, note: 'Argon2']
  totp_secret_enc varchar [note: '2FA, criptat']
  is_active boolean [default: true]
  last_login_at timestamp
  created_at timestamp [default: `now()`]
}

Table organization_members {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  user_id uuid [not null, ref: > users.id]
  role user_role [not null]
  indexes {
    (organization_id, user_id) [unique]
  }
}

Table audit_log {
  id bigserial [pk]
  organization_id uuid [ref: >? organizations.id]
  user_id uuid [ref: >? users.id]
  action varchar [not null, note: 'create / update / delete / validate / export']
  entity varchar [not null, note: 'numele tabelei']
  entity_id uuid
  old_values jsonb
  new_values jsonb
  ip_address inet
  created_at timestamp [default: `now()`]
}

// ───────────────────── Contrapartide ─────────────────────

Table counterparties {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  name varchar [not null]
  idno varchar(13)
  vat_code varchar
  iban_enc varchar [note: 'IBAN criptat']
  bank_code varchar
  address varchar
  default_budget_line_id uuid [ref: >? budget_lines.id, note: 'propunere AI']
  onec_guid uuid [note: 'GUID în 1C']
  indexes {
    (organization_id, idno) [unique]
  }
}

// ───────────────────── Granturi și bugete ─────────────────────

Table donors {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  name varchar [not null, note: 'ex. Fundația Soros Moldova']
  country varchar
}

Table grants {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  code varchar [not null]
  title varchar [not null]
  funding_type varchar [note: 'grant, donație, cotizații, percentage_designation (desemnare procentuală — ONG17 anexa 1D)...']
  designation_year int [note: 'anul desemnării procentuale']
  currency char(3) [not null]
  total_amount numeric(15,2) [not null, note: 'СуммаПроекта']
  account_id uuid [ref: >? accounts.id, note: 'СчетПроекта']
  accrue_funding_debt boolean [default: false, note: 'НачислятьЗадолженностьПоФинансированию']
  is_closed boolean [default: false]
  start_date date [not null]
  end_date date [not null]
  drive_folder_id varchar
  report_template_id uuid [ref: >? report_templates.id]
}

Table grant_donors {
  id uuid [pk]
  grant_id uuid [not null, ref: > grants.id]
  donor_id uuid [not null, ref: > donors.id]
  share_percent numeric(5,2) [note: 'ПроцентУчастия — cofinanțare']
  amount numeric(15,2)
  indexes {
    (grant_id, donor_id) [unique]
  }
}

Table cost_items {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  name varchar [not null, note: 'СтатьиЗатрат']
  con5_article varchar [note: 'rândul din 5-CON, ex. 071, 130 (Статьи5CON)']
  designation_category varchar [note: 'ONG17 anexa 1D: public_utility / social_charity / administrative']
}

Table organization_stats {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  period_end date [not null]
  members_count int [note: '5-CON rândul 300']
  volunteers_count int [note: '5-CON rândul 320']
  indexes {
    (organization_id, period_end) [unique]
  }
}

Table budget_lines {
  id uuid [pk]
  grant_id uuid [not null, ref: > grants.id]
  parent_id uuid [ref: >? budget_lines.id, note: 'linii ierarhice: 1, 1.1, 1.2']
  code varchar [not null]
  name varchar [not null, note: 'ex. Salarii, Transport, Echipament']
  cost_item_id uuid [ref: >? cost_items.id, note: 'СтатьяЗатрат — leagă linia de 5-CON']
  budget_version_id uuid [ref: >? budget_versions.id, note: 'versiunea bugetului din care face parte linia']
  unit varchar [note: 'lună, zi, bucată, persoană...']
  quantity numeric(12,2)
  unit_cost numeric(15,2)
  planned_amount numeric(15,2) [not null, note: 'total linie']
  donor_amount numeric(15,2) [note: 'contribuția donatorului']
  cofinancing_amount numeric(15,2) [note: 'cofinanțare / contribuție proprie']
  indexes {
    (grant_id, budget_version_id, code) [unique]
    (id, grant_id) [unique, note: 'țintă pentru cheia compusă: linia de buget aparține grantului indicat']
  }
}

Table budget_versions {
  id uuid [pk]
  grant_id uuid [not null, ref: > grants.id]
  version int [not null]
  valid_from date [not null, note: 'de când se aplică (realocare aprobată de donator)']
  approved_document_id uuid [ref: >? documents.id, note: 'scrisoarea / acordul de modificare']
  import_id uuid [ref: >? budget_imports.id]
  is_current boolean [default: true]
  indexes {
    (grant_id, version) [unique]
  }
}

Table grant_tranches {
  id uuid [pk]
  grant_id uuid [not null, ref: > grants.id]
  donor_id uuid [ref: >? donors.id]
  number int [not null]
  planned_date date
  amount numeric(15,2) [not null]
  currency char(3) [not null]
  condition text [note: 'ex. după raportul intermediar aprobat']
  status varchar [default: 'planned', note: 'planned / recognized / received / cancelled']
  received_document_id uuid [ref: >? documents.id, note: 'extrasul / încasarea']
}

Table budget_imports {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  grant_id uuid [ref: >? grants.id]
  storage_connection_id uuid [ref: >? storage_connections.id]
  file_id varchar [not null, note: 'bugetul original (Excel / PDF)']
  detected jsonb [note: 'linii, tranșe, cofinanțare recunoscute de AI, cu încredere']
  column_mapping jsonb [note: 'maparea confirmată — se reutilizează pentru același donator']
  file_total numeric(15,2)
  detected_total numeric(15,2)
  status varchar [default: 'to_review', note: 'to_review / confirmed / rejected']
  confirmed_by uuid [ref: >? users.id]
  created_at timestamp [default: `now()`]
}

// ───────────────────── Documente și AI ─────────────────────

Table documents {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  type document_type
  status document_status [not null, default: 'new']
  is_posted boolean [default: false, note: 'înregistrat (проведён)']
  deletion_mark boolean [default: false, note: 'marcat pentru ștergere']
  version int [default: 1, note: 'blocare optimistă la lucru simultan']
  storage_connection_id uuid [ref: >? storage_connections.id, note: 'Drive sau folder local']
  file_id varchar [note: 'scanul original (null pentru documente create manual)']
  file_name varchar
  mime_type varchar
  sha256 char(64) [note: 'detectare dubluri scanuri']
  counterparty_id uuid [ref: >? counterparties.id]
  doc_number varchar
  doc_date date
  total_amount numeric(15,2)
  currency char(3)
  uploaded_by uuid [ref: >? users.id]
  validated_by uuid [ref: >? users.id]
  validated_at timestamp
  created_at timestamp [default: `now()`]
  indexes {
    (organization_id, sha256) [unique]
    (organization_id, status)
  }
}

Table document_extractions {
  id uuid [pk]
  document_id uuid [not null, ref: > documents.id]
  engine varchar [note: 'azure-docint / llm model']
  raw_text text
  fields jsonb [note: '{camp: {valoare, incredere}}']
  min_confidence numeric(4,3)
  created_at timestamp [default: `now()`]
}

Table invoices {
  id uuid [pk]
  document_id uuid [unique, not null, ref: - documents.id]
  series varchar [note: 'nr., data, contrapartida, totalul — în documents (antetul comun); totalurile TVA — calculate din invoice_lines (view)']
  e_invoice_id varchar [note: 'ID e-Factura SFS, dacă există']
}

Table invoice_lines {
  id uuid [pk]
  invoice_id uuid [not null, ref: > invoices.id]
  description varchar [not null]
  quantity numeric(12,3)
  unit varchar
  unit_price numeric(15,4)
  vat_rate numeric(5,2)
  amount numeric(15,2) [not null]
  line_kind line_kind [not null, default: 'service', note: 'o factură poate avea MF + OMVSD + materiale']
  account_id uuid [ref: >? accounts.id]
  budget_line_id uuid [ref: >? budget_lines.id]
  cost_item_id uuid [ref: >? cost_items.id]
  fixed_asset_id uuid [ref: >? fixed_assets.id, note: 'fișa MF creată automat din acest rând']
  put_into_use boolean [default: true, note: 'MF pus în funcțiune / OMVSD dat în exploatare la aceeași dată']
}

Table payment_orders {
  id uuid [pk]
  document_id uuid [unique, not null, ref: - documents.id]
  direction payment_direction [not null, note: 'nr., data, suma, valuta — în documents']
  exchange_rate numeric(12,4) [note: 'curs BNM la dată']
  purpose varchar [note: 'destinația plății (la OTP max. 210 caractere)']
  invoice_id uuid [ref: >? invoices.id, note: 'factura achitată']
  bank_account_id uuid [ref: >? bank_accounts.id, note: 'contul plătitor']
  beneficiary_iban varchar [note: 'instantaneu (snapshot) — ce s-a trimis la bancă, nu se schimbă dacă se modifică contrapartida']
  beneficiary_name varchar [note: 'snapshot']
  beneficiary_idno varchar [note: 'snapshot']
  is_urgent boolean [default: false]
  kind varchar [default: 'regular', note: 'regular / grouped_tax (plată cumulată CAS, CAM, impozit pe venit)']
  tax_kind varchar [note: 'income_tax / cnas / cnam — pentru plata cumulată']
  batch_id uuid [ref: >? payment_batches.id, note: 'lotul de export în bancă']
  bank_status varchar [default: 'draft', note: 'draft / exported / executed (confirmat din extras)']
}

Table payment_order_lines {
  id uuid [pk]
  payment_order_id uuid [not null, ref: > payment_orders.id]
  person_id uuid [ref: >? persons.id]
  payroll_entry_id uuid [ref: >? payroll_entries.id]
  grant_id uuid [ref: >? grants.id]
  amount numeric(15,2) [not null]
  Note: 'rândurile pe persoane ale unei plăți cumulate — un singur comision bancar'
}

Table payment_batches {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  bank_format_id uuid [not null, ref: > bank_formats.id]
  bank_account_id uuid [not null, ref: > bank_accounts.id]
  created_at timestamp [default: `now()`]
  folder_path varchar [note: 'Bancă/Export/<Banca>/<AAAA-LL-ZZ_HHmm>/']
  file_id varchar [note: 'fișierul TXT/DBF generat']
  orders_count int
  total_amount numeric(15,2)
  created_by uuid [ref: >? users.id]
}

Table allocations {
  id uuid [pk]
  document_id uuid [not null, ref: > documents.id]
  budget_line_id uuid [not null, ref: > budget_lines.id]
  amount numeric(15,2) [not null, note: 'în valuta grantului']
  amount_mdl numeric(15,2)
  note varchar
  suggested_by_ai boolean [default: false]
}

// ───────────────────── Personal și salarizare ─────────────────────

Table persons {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  full_name varchar [not null]
  idnp_enc varchar [not null, note: 'IDNP criptat']
  birth_date date
  cpas varchar [note: 'cod personal de asigurare socială — IPC21 Tabelul 2']
}

Table contracts {
  id uuid [pk]
  person_id uuid [not null, ref: > persons.id]
  type contract_type [not null]
  is_main_job boolean [default: false, note: 'scutirea doar la locul de bază, doar CIM']
  department_id uuid [ref: >? departments.id, note: 'subdiviziunea — anexa IPC21']
  special_function_code varchar [note: 'codul funcției cu drept la pensie în condiții speciale']
  number varchar
  start_date date [not null]
  end_date date
  gross_amount numeric(15,2) [not null, note: 'salariu lunar sau onorariu']
  document_id uuid [ref: >? documents.id, note: 'contractul scanat']
}

Table payroll_periods {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  year int [not null]
  month int [not null]
  is_closed boolean [default: false]
  indexes {
    (organization_id, year, month) [unique]
  }
}

Table payroll_entries {
  id uuid [pk]
  period_id uuid [not null, ref: > payroll_periods.id]
  contract_id uuid [not null, ref: > contracts.id, note: 'calcul PE CONTRACT, nu pe persoană']
  income_code varchar [not null, note: 'cod sursă venit IPC21: SAL (CIM), PL / PLs (contract civil), DON pf, FOL...']
  period_start date [note: 'perioada de muncă — IPC21 Tabelul 2 c5']
  period_end date [note: 'IPC21 Tabelul 2 c6']
  insured_category varchar [note: 'categoria persoanei asigurate — Tabelul 2 c7']
  cnas_tariff numeric(5,2) [note: '24 / 29 / 6 ... — Tabelul 2 c8']
  cnas_base numeric(15,2) [note: 'baza contribuției — Tabelul 2 c9']
  sick_benefit numeric(15,2) [default: 0, note: 'indemnizație incapacitate — Tabelul 2 c10']
  gross numeric(15,2) [not null]
  personal_exemption numeric(15,2) [default: 0, note: '0 pentru contract civil']
  dependents_exemption numeric(15,2) [default: 0]
  taxable_income numeric(15,2)
  income_tax numeric(15,2)
  cnam_employee numeric(15,2)
  cnas_employer numeric(15,2)
  net numeric(15,2)
  budget_line_id uuid [ref: >? budget_lines.id]
  calc_details jsonb [note: 'ce cote (tax_rates.id) s-au folosit']
}

Table individual_payments {
  id uuid [pk]
  document_id uuid [unique, not null, ref: - documents.id, note: '„Plată către persoană fizică”']
  person_id uuid [not null, ref: > persons.id]
  payment_kind varchar [not null, note: 'rent / agri_land_rent / services / donation / interest / royalty']
  income_code varchar [not null, note: 'cod IPC21: FOL, PLs, PL, DON pf, DOB, ROY...']
  accrual_date date [not null]
  payment_date date
  gross numeric(15,2) [not null]
  tax_rate_id uuid [ref: >? tax_rates.id, note: 'cota de reținere valabilă la dată']
  income_tax numeric(15,2) [default: 0]
  net numeric(15,2)
  cost_item_id uuid [ref: >? cost_items.id]
  grant_id uuid [ref: >? grants.id]
  budget_line_id uuid [ref: >? budget_lines.id]
}

// ───────────────────── Cote și legislație ─────────────────────

Table tax_rates {
  id uuid [pk]
  code varchar [not null, note: 'INCOME_TAX, CNAS_EMPLOYER, CNAM_EMPLOYEE, PERSONAL_EXEMPTION_YEAR, VAT_STANDARD...']
  applies_to contract_type [note: 'null = ambele']
  value numeric(15,4) [not null, note: 'procent sau sumă']
  is_percent boolean [default: true]
  valid_from date [not null]
  valid_to date
  legal_basis varchar [note: 'ex. Codul Fiscal art. 33']
  source_url varchar
  approved_by uuid [ref: >? users.id]
  legal_update_id uuid [ref: >? legal_updates.id]
  indexes {
    (code, applies_to, valid_from) [unique, note: 'UNIQUE NULLS NOT DISTINCT (PostgreSQL 15+): applies_to null = ambele tipuri']
  }
}

Table legal_updates {
  id uuid [pk]
  source_url varchar [not null]
  detected_at timestamp [default: `now()`]
  title varchar
  ai_summary text
  proposed_changes jsonb [note: 'cote noi propuse de AI']
  status update_status [default: 'pending']
  reviewed_by uuid [ref: >? users.id]
  reviewed_at timestamp
}

// ───────────────────── Rapoarte donatori ─────────────────────

Table report_templates {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  donor_id uuid [ref: >? donors.id]
  name varchar [not null]
  storage_connection_id uuid [ref: >? storage_connections.id]
  file_id varchar [not null, note: 'șablonul Excel original al donatorului']
  mapping jsonb [note: 'celulă Excel -> linie de buget / perioadă / tip valoare; propus de AI, confirmat de contabil']
  mapping_confirmed_by uuid [ref: >? users.id]
}

Table donor_requirements {
  id uuid [pk]
  donor_id uuid [not null, ref: > donors.id]
  grant_id uuid [ref: >? grants.id, note: 'null = valabil pentru toate granturile donatorului']
  instructions text [not null, note: 'scris de contabil în cuvinte: ce documente cere donatorul']
  rules jsonb [note: 'reguli structurate generate de AI: tip cheltuială -> tipuri de documente cerute']
  confirmed_by uuid [ref: >? users.id]
  updated_at timestamp
}

Table report_packages {
  id uuid [pk]
  template_id uuid [not null, ref: > report_templates.id]
  grant_id uuid [not null, ref: > grants.id]
  period_from date [not null]
  period_to date [not null]
  status varchar [note: 'generating / ready / failed']
  root_folder_id varchar [note: 'Rapoarte/<Donator>/<Grant>/<Perioada>']
  excel_file_id varchar
  missing_documents jsonb [note: 'lista de verificare: ce lipsește pe fiecare cheltuială']
  generated_by uuid [ref: >? users.id]
  created_at timestamp [default: `now()`]
}

Table report_package_items {
  id uuid [pk]
  package_id uuid [not null, ref: > report_packages.id]
  budget_line_id uuid [ref: >? budget_lines.id]
  document_id uuid [not null, ref: > documents.id]
  folder_path varchar [note: 'ex. 2.1 Echipament/']
  file_id varchar [note: 'copia/scurtătura din pachet']
  selected_by_ai boolean [default: true]
}

// ───────────────────── Nucleul contabil ─────────────────────

Table accounts {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  code varchar(10) [not null, note: 'ex. 221, 521, 531']
  name varchar [not null]
  parent_id uuid [ref: >? accounts.id]
  account_kind account_kind [not null]
  is_group boolean [default: false, note: 'cont sintetic fără înregistrări directe']
  is_currency boolean [default: false]
  indexes {
    (organization_id, code) [unique]
  }
}

Table accounting_policies {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  valid_from date [not null]
  grant_receivable_account_id uuid [ref: >? accounts.id, note: '234.4 sau 235 — creanțe privind mijloacele cu destinație specială']
  grant_recognition varchar [default: 'on_signing', note: 'on_signing / on_receipt (contract neautentificat)']
  stock_to_deferred_income varchar [default: 'unused_only', note: 'all / unused_only — stocuri și avansuri la 535']
  fa_valuation_method varchar
  settings jsonb [note: 'alte opțiuni ale politicii contabile']
  approved_by uuid [ref: >? users.id]
  indexes {
    (organization_id, valid_from) [unique]
  }
}

Table posting_rules {
  id uuid [pk]
  organization_id uuid [ref: >? organizations.id, note: 'null = regulă standard; altfel corecția organizației']
  document_type varchar [not null, note: 'ex. invoice, grant_income, payroll, month_close.depreciation']
  operation varchar [not null, note: 'ex. expense, stock_distribution, fixed_asset_fund, fx_difference']
  conditions jsonb [note: '{funding: special_purpose|unrestricted|economic, line_kind, currency...}']
  debit_account varchar [not null]
  credit_account varchar [not null]
  analytics jsonb [note: 'ce subconto / dimensiuni se completează']
  source_ref varchar [not null, note: 'ex. IM188; ART sit.3; SEM — obligatoriu']
  valid_from date [not null]
  valid_to date
  version int [default: 1]
  changed_by uuid [ref: >? users.id]
  change_reason text
  release_id uuid [ref: >? releases.id, note: 'null = stabil; altfel varianta beta din această versiune']
}

Table departments {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  name varchar [not null]
  parent_id uuid [ref: >? departments.id]
  cuatm varchar [note: 'codul localității subdiviziunii — anexa IPC21']
}

Table accounting_periods {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  year int [not null]
  month int [not null]
  is_closed boolean [default: false]
  closed_by uuid [ref: >? users.id]
  closed_at timestamp
  indexes {
    (organization_id, year, month) [unique]
  }
}

Table entry_lines {
  id bigserial [pk]
  organization_id uuid [not null, ref: > organizations.id]
  document_id uuid [not null, ref: > documents.id, note: 'registratorul (ca în 1C)']
  line_no int [not null]
  entry_date date [not null]
  debit_account_id uuid [not null, ref: > accounts.id]
  credit_account_id uuid [not null, ref: > accounts.id]
  amount numeric(15,2) [not null, note: 'în MDL (Сумма)']
  tax_amount numeric(15,2) [note: 'suma în contabilitatea fiscală (СуммаНУ)']
  department_id uuid [ref: >? departments.id, note: 'Подразделение']
  currency char(3)
  currency_amount numeric(15,2)
  quantity numeric(15,3)
  grant_id uuid [ref: >? grants.id]
  budget_line_id uuid [ref: >? budget_lines.id]
  cost_item_id uuid [ref: >? cost_items.id, note: 'dă rândul din 5-CON']
  activity_type varchar [note: 'ONG17: special_purpose / economic / other']
  is_non_statutory boolean [default: false, note: 'ONG17: contrar destinației / neprevăzut de statut']
  description varchar
  indexes {
    (organization_id, entry_date)
    (debit_account_id, entry_date)
    (credit_account_id, entry_date)
    (grant_id, budget_line_id, entry_date)
    document_id
  }
  Note: 'partiționată pe ani (PARTITION BY RANGE entry_date); se scrie doar prin posting, în tranzacție cu account_turnovers'
}

Table opening_balances {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  account_id uuid [not null, ref: > accounts.id]
  balance_date date [not null, note: 'data trecerii de la 1C']
  debit numeric(15,2) [default: 0]
  credit numeric(15,2) [default: 0]
  subconto jsonb
  imported_from_1c boolean [default: true]
}

Table bank_accounts {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  iban_enc varchar [not null]
  bank_name varchar
  bank_code varchar
  currency char(3) [not null]
  account_id uuid [ref: >? accounts.id, note: 'contul contabil 242/243']
  grant_id uuid [ref: >? grants.id, note: 'cont dedicat grantului']
}

Table fixed_assets {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  inventory_no varchar [not null]
  name varchar [not null]
  initial_cost numeric(15,2) [not null]
  residual_value numeric(15,2) [default: 0]
  useful_life_months int
  depreciation_method varchar [default: 'linear']
  asset_group varchar [note: 'grupa / categoria — dă durata și metoda implicită']
  account_id uuid [ref: >? accounts.id, note: 'contul MF (ex. 123)']
  depreciation_account_id uuid [ref: >? accounts.id, note: 'contul amortizării (ex. 124)']
  expense_account_id uuid [ref: >? accounts.id, note: 'unde merge cheltuiala cu amortizarea']
  commissioning_date date
  depreciation_start date [note: 'luna următoare punerii în funcțiune']
  status varchar [default: 'in_use', note: 'in_use / suspended / disposed']
  department_id uuid [ref: >? departments.id]
  grant_id uuid [ref: >? grants.id]
  budget_line_id uuid [ref: >? budget_lines.id]
  document_id uuid [ref: >? documents.id, note: 'factura din care a fost creat']
}

Table month_close_runs {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  year int [not null]
  month int [not null]
  document_id uuid [ref: >? documents.id, note: 'registratorul înregistrărilor închiderii']
  steps jsonb [note: '[{step: depreciation, status: done, entries: 12}, ...]']
  status varchar [note: 'draft / done / reverted']
  run_by uuid [ref: >? users.id]
  run_at timestamp
  indexes {
    (organization_id, year, month) [unique]
  }
}

// ───────────────────── Surse de documente ─────────────────────

Table storage_connections {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  provider storage_provider [not null]
  name varchar [not null, note: 'ex. Drive-ul organizației, Folder contabilitate']
  root_path varchar [note: 'ID folder Drive / cale locală']
  credentials_enc text [note: 'token OAuth sau token agent, criptat']
  owner_user_id uuid [ref: >? users.id, note: 'pentru Drive personal / agent pe calculatorul utilizatorului']
  is_default boolean [default: false]
  last_sync_at timestamp
}

// ───────────────────── Banca ─────────────────────

Table bank_formats {
  id uuid [pk]
  bank_name varchar [not null]
  file_type bank_file_type [not null]
  direction varchar [not null, note: 'import_statement / export_payments']
  encoding varchar [default: 'cp1251']
  layout jsonb [not null, note: 'separator sau lățimi fixe, maparea câmpurilor']
  version int [default: 1]
}

Table bank_imports {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  bank_account_id uuid [not null, ref: > bank_accounts.id]
  format_id uuid [not null, ref: > bank_formats.id]
  file_name varchar
  file_sha256 char(64)
  rows_total int
  rows_created int
  rows_skipped int [note: 'deja importate']
  rows_failed int
  errors jsonb
  imported_by uuid [ref: >? users.id]
  imported_at timestamp [default: `now()`]
}

Table bank_transactions {
  id uuid [pk]
  import_id uuid [not null, ref: > bank_imports.id]
  dedup_key varchar [unique, not null, note: 'bancă+cont+dată+nr+sumă — fără dubluri la reimport']
  tx_date date [not null]
  direction payment_direction [not null]
  amount numeric(15,2) [not null]
  counterparty_iban varchar
  counterparty_idno varchar
  purpose varchar
  document_id uuid [ref: >? documents.id, note: 'documentul creat din rând']
}

// ───────────────────── e-Factura ─────────────────────

Table efactura_messages {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  direction varchar [not null, note: 'received / sent']
  efactura_id varchar [not null]
  status varchar [note: 'draft / sent / signed / accepted / rejected']
  payload_xml text
  document_id uuid [ref: >? documents.id]
  synced_at timestamp
  indexes {
    (organization_id, efactura_id) [unique]
  }
}

// ───────────────────── Asistentul AI ─────────────────────

Table ai_conversations {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  user_id uuid [not null, ref: > users.id]
  title varchar
  context jsonb [note: 'ecranul / documentul deschis la început']
  created_at timestamp [default: `now()`]
}

Table ai_messages {
  id bigserial [pk]
  conversation_id uuid [not null, ref: > ai_conversations.id]
  role varchar [not null, note: 'user / assistant / tool']
  content text
  tool_calls jsonb
  sources jsonb [note: 'linkuri din căutarea pe internet']
  created_at timestamp [default: `now()`]
}

Table ai_actions {
  id uuid [pk]
  message_id bigint [ref: >? ai_messages.id]
  kind varchar [not null, note: 'draft_document / propose_entries / ui_change / donor_package / tax_rate_update / remember_rule']
  payload jsonb [not null]
  status ai_action_status [default: 'pending']
  decided_by uuid [ref: >? users.id]
  decided_at timestamp
  result_ref varchar [note: 'ce s-a creat la aplicare (id document, override...)']
}

Table ai_memory {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  rule text [not null, note: 'ex. „la noi chiria se pune pe linia 3.4”']
  created_by uuid [ref: >? users.id]
  created_at timestamp [default: `now()`]
  is_active boolean [default: true]
}

Table ui_overrides {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  user_id uuid [ref: >? users.id, note: 'null = pentru toată organizația']
  form_key varchar [not null, note: 'ex. document.invoice.form, document.invoice.list']
  element_key varchar [not null, note: 'ex. command.dtkt, field.grant, column.department']
  change jsonb [not null, note: '{label | order | visible | default}']
  version int [default: 1]
  created_by_ai boolean [default: false]
  approved_by uuid [ref: >? users.id, note: 'obligatoriu pentru override-uri de organizație']
  release_id uuid [ref: >? releases.id, note: 'null = stabil; altfel varianta beta din această versiune']
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
}

// ───────────────────── Migrare din 1C ─────────────────────

Table onec_import_runs {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  source varchar [note: 'odata / xml']
  period_from date
  period_to date
  status import_status [default: 'pending']
  stats jsonb [note: 'câte obiecte pe tip, erori']
  reconciliation jsonb [note: 'diferențe OSV aplicație vs 1C']
  started_by uuid [ref: >? users.id]
  started_at timestamp
  finished_at timestamp
}

Table onec_id_map {
  id bigserial [pk]
  organization_id uuid [not null, ref: > organizations.id]
  onec_type varchar [not null, note: 'ex. Catalog.Контрагенты']
  onec_guid uuid [not null]
  local_table varchar [not null]
  local_id uuid [not null]
  import_run_id uuid [ref: >? onec_import_runs.id]
  indexes {
    (organization_id, onec_type, onec_guid) [unique]
  }
}

// ───────────────────── Rapoarte fiscale și statistice ─────────────────────

Enum report_status {
  draft
  checked
  submitted
}

Table report_forms {
  id uuid [pk]
  code varchar [not null, note: 'IPC21, 5-CON, ONG17']
  authority varchar [not null, note: 'SFS / BNS']
  periodicity varchar [not null, note: 'month / quarter / year']
  version varchar [not null]
  valid_from date [not null]
  valid_to date
  structure jsonb [not null, note: 'celule, formule de completare, verificări']
  due_day_rule varchar [note: 'ex. ziua 25 a lunii următoare']
  indexes {
    (code, version) [unique]
  }
}

Table tax_reports {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  form_id uuid [not null, ref: > report_forms.id]
  period_from date [not null]
  period_to date [not null]
  status report_status [default: 'draft']
  data jsonb [note: 'valori calculate + corecții manuale']
  manual_overrides jsonb
  export_file_id varchar
  prepared_by uuid [ref: >? users.id]
  submitted_at timestamp
}

Table reporting_calendar {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  form_id uuid [not null, ref: > report_forms.id]
  period_from date [not null]
  period_to date [not null]
  due_date date [not null]
  tax_report_id uuid [ref: >? tax_reports.id, note: 'null = încă neprezentat']
  indexes {
    (organization_id, form_id, period_from) [unique]
  }
}

// ───────────────────── Îmbunătățire continuă: cereri și versiuni ─────────────────────

Table change_requests {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  created_by uuid [not null, ref: > users.id]
  description text [not null, note: 'cererea în cuvintele utilizatorului']
  screen_context jsonb [note: 'ecranul, documentul, captura de ecran']
  ai_summary text [note: 'cerința clarificată de asistent și confirmată de utilizator']
  level varchar [note: 'config (nivel 1) / code (nivel 2)']
  status varchar [default: 'new', note: 'new / in_progress / beta / promoted / rejected / failed']
  branch varchar [note: 'beta/<nr-cerere>']
  pull_request_url varchar
  release_id uuid [ref: >? releases.id, note: 'versiunea beta în care a intrat']
  decided_by uuid [ref: >? users.id]
  decided_at timestamp
  created_at timestamp [default: `now()`]
}

Table releases {
  id uuid [pk]
  version varchar [unique, not null, note: 'ex. 1.8.0-beta.3 / 1.8.0']
  channel varchar [not null, note: 'beta / stable']
  git_commit varchar
  notes text [note: 'ce s-a schimbat — vizibil în aplicație']
  tests_passed boolean
  deployed_at timestamp
  promoted_from uuid [ref: >? releases.id, note: 'beta din care a devenit stabil']
  rolled_back_at timestamp
}

// ───────────────────── Normalizare și performanță ─────────────────────

Table account_analytics {
  id uuid [pk]
  account_id uuid [not null, ref: > accounts.id]
  position int [not null, note: '1, 2, 3 — ordinea subconto (în locul coloanelor subconto1..3)']
  subconto_type subconto_type [not null]
  is_required boolean [default: true]
  indexes {
    (account_id, position) [unique]
  }
}

Table entry_line_analytics {
  entry_line_id bigint [not null, ref: > entry_lines.id]
  side char(1) [not null, note: 'D / K']
  subconto_type subconto_type [not null]
  ref_id uuid [not null, note: 'id-ul din tabela tipului (counterparties, contracts, persons...)']
  indexes {
    (entry_line_id, side, subconto_type) [pk]
    (subconto_type, ref_id) [note: 'fișa contului pe contrapartidă / contract — rapid']
  }
}

Table exemption_claims {
  id uuid [pk]
  person_id uuid [not null, ref: > persons.id]
  contract_id uuid [not null, ref: > contracts.id, note: 'doar CIM de bază — verificat de regulă']
  kind varchar [not null, note: 'personal / major_personal / dependents / disabled_dependents']
  dependents_count int [default: 0]
  valid_from date [not null]
  valid_to date
  document_id uuid [ref: >? documents.id, note: 'cererea de scutire semnată']
  Note: 'în locul persons.dependents_count: scutirile se schimbă în timp și țin de contract, nu de persoană'
}

Table contract_funding {
  id uuid [pk]
  contract_id uuid [not null, ref: > contracts.id]
  grant_id uuid [not null, ref: > grants.id]
  budget_line_id uuid [ref: >? budget_lines.id]
  share_percent numeric(5,2) [not null, note: 'ex. 60% proiect A, 40% proiect B — fără dublă finanțare (suma ≤ 100%)']
  valid_from date [not null]
  valid_to date
}

Table account_turnovers {
  id bigserial [pk]
  organization_id uuid [not null, ref: > organizations.id]
  account_id uuid [not null, ref: > accounts.id]
  period date [not null, note: 'prima zi a lunii']
  grant_id uuid [ref: >? grants.id]
  currency char(3) [not null, default: 'MDL']
  debit numeric(17,2) [not null, default: 0]
  credit numeric(17,2) [not null, default: 0]
  debit_currency numeric(17,2) [default: 0]
  credit_currency numeric(17,2) [default: 0]
  indexes {
    (organization_id, account_id, period, grant_id, currency) [unique, note: 'UNIQUE NULLS NOT DISTINCT — grant_id poate lipsi (rulaje fără proiect); o cheie primară nu acceptă NULL']
  }
  Note: 'tabel de totaluri (ca „итоги” din 1C): denormalizare controlată, actualizată în aceeași tranzacție cu entry_lines → balanța pe un an se citește din ~câteva sute de rânduri, nu din sute de mii'
}

Ref: entry_lines.(budget_line_id, grant_id) >? budget_lines.(id, grant_id)
